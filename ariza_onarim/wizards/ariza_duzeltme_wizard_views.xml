<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ariza_duzeltme_wizard_form" model="ir.ui.view">
        <field name="name">ariza.duzeltme.wizard.form</field>
        <field name="model">ariza.duzeltme.wizard</field>
        <field name="arch" type="xml">
            <form string="Bilgileri Düzelt">
                <div class="alert alert-warning" role="alert">
                    Bu ekran, onarım akışı tamamlandıktan sonra yanlış girilmiş bilgilerin
                    düzeltilmesi içindir. Yapılan değişiklikler eski/yeni değerleriyle birlikte
                    kayıt geçmişine yazılır. Düzeltme SMS veya e-posta göndermez.
                </div>
                <group>
                    <group>
                        <field name="ariza_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="ariza_adi"/>
                        <field name="urun"/>
                    </group>
                    <group>
                        <field name="ariza_tipi"/>
                    </group>
                </group>
                <group string="Düzeltilecek Bilgiler">
                    <field name="onarim_bilgisi"
                           placeholder="Yapılan onarım işlemleri..."/>
                    <field name="onarim_disi_aciklama"
                           placeholder="Onarımın mümkün olmama nedeni..."/>
                </group>
                <group attrs="{'invisible': [('ariza_tipi', '=', 'magaza')]}">
                    <group>
                        <field name="garanti_kapsaminda_mi"/>
                        <field name="onarim_ucreti"
                               attrs="{'readonly': [('garanti_kapsaminda_mi', 'in', ['evet', 'urun_degisimi'])]}"/>
                    </group>
                    <group>
                        <field name="ucret_bilgisi" placeholder="Ücret ile ilgili açıklama..."/>
                    </group>
                </group>
                <group string="Gerekçe">
                    <field name="duzeltme_nedeni" nolabel="1"
                           placeholder="Bu düzeltmenin neden yapıldığını yazınız (zorunlu). Örn: Cihaz garanti kapsamında olmadığı hâlde garantili işaretlenmiş."/>
                </group>
                <footer>
                    <button name="action_duzeltmeyi_kaydet"
                            string="Düzeltmeyi Kaydet"
                            type="object"
                            class="btn-primary"/>
                    <button string="Vazgeç"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
