<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- B Stok kartları listesi (eski ve yeni); eski kartları ana ürüne bağlama -->
    <record id="view_ariza_b_stok_kart_tree" model="ir.ui.view">
        <field name="name">ariza.b.stok.kart.tree</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="B Stok Kartları" create="0" delete="0" edit="0"
                  decoration-muted="b_stok_adedi &lt;= 0">
                <header>
                    <button name="action_b_kart_bagla" type="object" string="Ana Ürüne Bağla"
                            class="btn-primary"/>
                </header>
                <field name="default_code"/>
                <field name="name"/>
                <field name="b_stok_adedi"/>
                <field name="b_mevcut_oranlar"/>
                <field name="lst_price" string="Satış Fiyatı"/>
                <field name="b_kaynak_urun_id"/>
                <field name="b_indirim_orani"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_ariza_b_stok_kart_search" model="ir.ui.view">
        <field name="name">ariza.b.stok.kart.search</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="B Stok Kartları">
                <field name="default_code"/>
                <field name="name"/>
                <field name="b_kaynak_urun_id"/>
                <filter name="bagli_degil" string="Ana Ürüne Bağlı Değil"
                        domain="[('b_kaynak_urun_id', '=', False)]"/>
                <filter name="bagli" string="Bağlı"
                        domain="[('b_kaynak_urun_id', '!=', False)]"/>
                <separator/>
                <filter name="stoklu" string="Stoklu" domain="[('b_stok_adedi', '&gt;', 0)]"/>
                <separator/>
                <filter name="arsiv" string="Arşivlenmiş" domain="[('active', '=', False)]"/>
                <group expand="0" string="Grupla">
                    <filter name="grup_oran" string="Oran" context="{'group_by': 'b_indirim_orani'}"/>
                    <filter name="grup_ana" string="Ana Ürün" context="{'group_by': 'b_kaynak_urun_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ariza_b_stok_kart" model="ir.actions.act_window">
        <field name="name">B Stok Kartları</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_ariza_b_stok_kart_tree"/>
        <field name="search_view_id" ref="view_ariza_b_stok_kart_search"/>
        <field name="domain">['|', '|', '|', '|', ('b_kaynak_urun_id', '!=', False), ('default_code', 'ilike', 'B-STOK'), ('name', 'ilike', 'B-STOK'), ('default_code', 'ilike', 'BSTOK'), ('name', 'ilike', 'BSTOK')]</field>
        <field name="context">{'search_default_bagli_degil': 1, 'search_default_stoklu': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bağlanmamış stoklu B kartı yok.</p>
            <p>Eski "(B-STOK)" kartlarını seçip "Ana Ürüne Bağla" ile oranlarını verin.
               Bağlanan kart, aynı ürün aynı oranla yeniden çevrildiğinde tekrar kullanılır.</p>
        </field>
    </record>

    <menuitem id="menu_ariza_b_stok_kart"
              name="B Stok Kartları"
              parent="menu_ariza_root"
              action="action_ariza_b_stok_kart"
              sequence="18"
              groups="ariza_onarim.group_ariza_manager"/>

    <!-- Bağlama sihirbazı -->
    <record id="view_ariza_b_stok_bagla_wizard_form" model="ir.ui.view">
        <field name="name">ariza.b.stok.bagla.wizard.form</field>
        <field name="model">ariza.b.stok.bagla.wizard</field>
        <field name="arch" type="xml">
            <form string="Ana Ürüne Bağla">
                <div class="alert alert-info" role="alert">
                    Ana ürün koddan, oran kartın bugün bulunduğu listeden önerildi.
                    Kart ve ana ürün adlarının aynı ürün olduğunu kontrol edin; emin olmadığınız satırı silin.
                    Kartın kodu ve stoğu değişmez; fiyatı ana ürünle eşitlenir,
                    kart seçilen oranın B-STOK promosyonuna taşınır.
                </div>
                <field name="satir_ids">
                    <tree editable="bottom" create="0" delete="1">
                        <field name="kart_id" force_save="1" options="{'no_open': True}"/>
                        <field name="kart_adi"/>
                        <field name="stok"/>
                        <field name="mevcut_oranlar"/>
                        <field name="ana_urun_id" options="{'no_create': True}"/>
                        <field name="ana_urun_adi"/>
                        <field name="oran"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_bagla" type="object" string="Bağla" class="btn-primary"/>
                    <button string="Vazgeç" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Dönüşüm formu: etiket butonu -->
    <record id="view_ariza_b_stok_donusum_form_etiket" model="ir.ui.view">
        <field name="name">ariza.b.stok.donusum.form.etiket</field>
        <field name="model">ariza.b.stok.donusum</field>
        <field name="inherit_id" ref="view_ariza_b_stok_donusum_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_etiket_yazdir" type="object" string="Etiket Yazdır"
                        icon="fa-print" class="btn-primary" states="tamam"/>
            </xpath>
        </field>
    </record>
</odoo>
