<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ariza_depo_stok_tree" model="ir.ui.view">
        <field name="name">ariza.depo.stok.tree</field>
        <field name="model">ariza.depo.stok</field>
        <field name="arch" type="xml">
            <tree string="Arıza Deposu Stoğu" editable="top" create="0" delete="0">
                <field name="product_id" readonly="1"/>
                <field name="miktar" readonly="1" sum="Toplam"/>
                <field name="not_metni" placeholder="Örn: sapı kırık, onarıldı, %15 indirimle satılabilir"/>
                <field name="not_yazan_id" readonly="1" optional="show"/>
                <field name="not_tarihi" readonly="1" optional="show"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_ariza_depo_stok_search" model="ir.ui.view">
        <field name="name">ariza.depo.stok.search</field>
        <field name="model">ariza.depo.stok</field>
        <field name="arch" type="xml">
            <search string="Arıza Deposu Stoğu">
                <field name="product_id"/>
                <field name="not_metni"/>
                <filter name="notlu" string="Notu Olanlar" domain="[('not_metni', '!=', False)]"/>
                <filter name="notsuz" string="Notu Olmayanlar" domain="[('not_metni', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ariza_depo_stok" model="ir.actions.act_window">
        <field name="name">Arıza Deposu Stoğu</field>
        <field name="res_model">ariza.depo.stok</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_ariza_depo_stok_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ARIZA/Stok konumunda ürün yok.</p>
        </field>
    </record>

    <menuitem id="menu_ariza_depo_stok"
              name="Arıza Deposu Stoğu"
              parent="menu_ariza_root"
              action="action_ariza_depo_stok"
              sequence="15"
              groups="ariza_onarim.group_ariza_manager"/>
</odoo>
