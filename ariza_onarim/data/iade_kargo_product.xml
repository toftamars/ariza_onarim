<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Müşteri ürünü iade kargo sevkiyatlarında kullanılan stok-dışı kalem.
            Consumable olduğu için envanteri etkilemez; weight=1.0 sayesinde
            picking'in shipping_weight değeri 0 olmaz (Aras booking için gerekli).
            Gerçek ağırlık farklıysa kullanıcı picking üzerinde düzeltebilir.
        -->
        <record id="product_musteri_urunu_kargo" model="product.product">
            <field name="name">Müşteri Ürünü (Kargo)</field>
            <field name="default_code">ARZ-IADE-KARGO</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="weight">1.0</field>
        </record>
    </data>
</odoo>
