<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Kargo Çıktısı raporları - arıza kaydının standart "Yazdır" menüsünde görünür.
        Şablon modülün KENDİ şablonudur (Studio'ya t-call bağımlılığı 2026-08-14'te
        kaldırıldı): müşteri ürünlerinde tabloda temsili kalem (ARZ-KARGO) yerine
        GERÇEK ürün bilgisi (marka + ürün + model + seri no) basılır.
        Basılan picking: müşteri ürününde iade kargosu (iade_transfer_id) öncelikli,
        yoksa gidiş kargosu (transfer_id); mağaza ürününde arıza transferi.
    -->

    <!-- Paperformat'lar (Studio raporlarıyla birebir aynı değerler) -->
    <record id="paperformat_kargo_ciktisi_a5" model="report.paperformat">
        <field name="name">Arıza - Kargo Çıktısı A5 (Üst Boşluksuz)</field>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>
    <record id="paperformat_kargo_ciktisi_a4" model="report.paperformat">
        <field name="name">Arıza - Kargo Çıktısı A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <!-- Aras Kargo logosu (tek yerde gömülü; kargo çıktısı + arıza kayıt barkod şeridi kullanır) -->
    <template id="aras_kargo_logo">
        <img src="data:image/png;base64," style="max-height: 50px;" alt="Aras Kargo"/>
    </template>

    <!--
        Kargo Çıktısı belge gövdesi.
        Çağıran şablon `ariza` (ariza.kayit) ve `kargo_picking` (stock.picking)
        değişkenlerini set etmiş olmalı.
    -->
    <template id="report_kargo_ciktisi_document">
        <div class="page">
            <!-- Barkod şeridi: transfer no + firma logosu + Aras barkodu -->
            <table class="border" style="width:100%;text-align:justify;">
                <tr>
                    <td align="center" style="width:35%;">
                        <span t-field="kargo_picking.name"
                              t-options="{'widget': 'barcode', 'width': 750, 'height': 125, 'img_style': 'width:300px;height:60px;'}"/>
                        <br/>
                        <b><span t-field="kargo_picking.name"/></b>
                        <br/>
                        <b>IRS.NO: <span t-esc="kargo_picking.document_number or ''"/></b>
                    </td>
                    <td align="center" style="width:30%;">
                        <img t-if="kargo_picking.company_id.logo"
                             t-att-src="image_data_uri(kargo_picking.company_id.logo)"
                             style="max-height: 70px;"
                             alt="Logo"/>
                    </td>
                    <td align="center" style="width:35%;">
                        <t t-if="kargo_picking.carrier_tracking_ref">
                            <span t-field="kargo_picking.carrier_tracking_ref"
                                  t-options="{'widget': 'barcode', 'width': 750, 'height': 125, 'img_style': 'width:300px;height:60px;'}"/>
                            <br/>
                            <b><span t-field="kargo_picking.carrier_tracking_ref"/></b>
                            <br/>
                            <t t-if="kargo_picking.carrier_id.delivery_type == 'aras'">
                                <t t-call="ariza_onarim.aras_kargo_logo"/>
                            </t>
                        </t>
                    </td>
                </tr>
            </table>
            <br/>
            <!-- Alıcı / Gönderici -->
            <table style="width:100%;font-size: 13px;">
                <tr>
                    <td style="width:50%;">
                        <b>Alıcı: <span t-field="kargo_picking.partner_id.name"/></b>
                        <br/>
                        <span t-field="kargo_picking.partner_id.street"/>
                        <span t-field="kargo_picking.partner_id.street2"/>
                        <br/>
                        <span t-field="kargo_picking.partner_id.city"/> /
                        <span t-field="kargo_picking.partner_id.state_id.name"/> /
                        <span t-field="kargo_picking.partner_id.country_id"/>
                        <br/>
                        <t t-if="kargo_picking.partner_id.phone">
                            Tel: <span t-field="kargo_picking.partner_id.phone"/><br/>
                        </t>
                        <t t-if="kargo_picking.partner_id.mobile">
                            Mobil: <span t-field="kargo_picking.partner_id.mobile"/>
                        </t>
                    </td>
                    <td style="width:20%;"></td>
                    <td style="width:30%;">
                        <t t-set="gonderici" t-value="kargo_picking.location_id.warehouse_id.partner_id or kargo_picking.company_id"/>
                        <b>Gönderici: <span t-field="gonderici.name"/></b>
                        <br/>
                        <span t-field="gonderici.street"/>
                        <span t-field="gonderici.street2"/>
                        <br/>
                        <span t-field="gonderici.city"/> /
                        <span t-field="gonderici.state_id.name"/> /
                        <span t-field="gonderici.country_id"/>
                        <br/>
                        Tel: <span t-field="gonderici.phone"/>
                    </td>
                </tr>
            </table>
            <br/>
            <!-- Ürün tablosu -->
            <table class="table table-sm table-striped" style="width:100%;font-size: 13px;">
                <thead>
                    <tr>
                        <th style="width:5%;" align="center"><strong>Sıra</strong></th>
                        <th style="width:20%;" align="left"><strong>Ürün Kodu</strong></th>
                        <th style="width:65%;" align="left"><strong>Ürün</strong></th>
                        <th style="width:5%;" align="right"><strong>Miktar</strong></th>
                        <th style="width:5%;" align="right"><strong>Birim</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Müşteri ürünü: kalem temsili olduğundan GERÇEK ürün arıza kaydından yazılır -->
                    <t t-if="ariza.ariza_tipi == 'musteri'">
                        <tr>
                            <td style="text-align:center;">1</td>
                            <td style="vertical-align: middle;">
                                <span t-esc="(ariza.invoice_line_id.product_id.default_code if ariza.invoice_line_id and ariza.invoice_line_id.product_id else '') or '-'"/>
                            </td>
                            <td>
                                <span t-esc="' - '.join([p for p in [(ariza.marka_id.name if ariza.marka_id else (ariza.marka_manu or '')), (ariza.urun or ''), (ariza.model or '')] if p])"/>
                                <t t-if="ariza.seri_no">
                                    <br/><span style="font-size:11px;">Seri No: <t t-esc="ariza.seri_no"/></span>
                                </t>
                            </td>
                            <td align="right">1</td>
                            <td align="right">Adet</td>
                        </tr>
                    </t>
                    <!-- Mağaza ürünü: transfer kalemleri zaten gerçek ürünlerdir -->
                    <t t-else="">
                        <t t-set="sira" t-value="0"/>
                        <t t-foreach="kargo_picking.move_line_ids_without_package" t-as="ml">
                            <t t-set="sira" t-value="sira + 1"/>
                            <tr>
                                <td style="text-align:center;"><span t-esc="sira"/></td>
                                <td style="vertical-align: middle;">
                                    <span t-field="ml.product_id.default_code"/>
                                </td>
                                <td><span t-field="ml.product_id.name"/></td>
                                <td align="right">
                                    <t t-if="kargo_picking.state == 'done'">
                                        <span t-field="ml.qty_done" t-options='{"widget": "float", "precision": 0}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="ml.product_uom_qty" t-options='{"widget": "float", "precision": 0}'/>
                                    </t>
                                </td>
                                <td align="right"><span t-field="ml.product_uom_id"/></td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>
    </template>

    <!-- QWeb sarmalayıcılar. Dış çerçeve web.basic_layout olmalı
         (web.html_container PDF'te Türkçe karakterleri bozuyor - 2026-08-14).
         Sayfa sonu yalnızca kayıtlar ARASINA konur (boş son sayfa oluşmasın). -->
    <template id="report_kargo_ciktisi">
        <t t-call="web.basic_layout">
            <t t-set="ariza_docs" t-value="docs"/>
            <t t-foreach="ariza_docs" t-as="ariza">
                <t t-set="kargo_picking" t-value="(ariza.iade_transfer_id or ariza.transfer_id) if ariza.ariza_tipi == 'musteri' else ariza.transfer_id"/>
                <t t-if="kargo_picking">
                    <t t-call="ariza_onarim.report_kargo_ciktisi_document"/>
                </t>
                <t t-else="">
                    <div class="page">
                        <h3>Kargo transferi bulunamadı</h3>
                        <p>Arıza kaydı <strong t-esc="ariza.name"/> için basılacak kargo transferi yok.</p>
                        <p>Gidiş kargosu ONAYLA adımında (kargo metodu seçiliyse), iade kargosu
                           teslim adımında "Adrese Gönderilsin" seçildiğinde otomatik oluşur;
                           Aras barkodu transfer doğrulanınca gelir.</p>
                    </div>
                </t>
                <p t-if="not ariza_last" style="page-break-after: always;"/>
            </t>
        </t>
    </template>
    <template id="report_kargo_ciktisi_a4">
        <t t-call="web.basic_layout">
            <t t-set="ariza_docs" t-value="docs"/>
            <t t-foreach="ariza_docs" t-as="ariza">
                <t t-set="kargo_picking" t-value="(ariza.iade_transfer_id or ariza.transfer_id) if ariza.ariza_tipi == 'musteri' else ariza.transfer_id"/>
                <t t-if="kargo_picking">
                    <t t-call="ariza_onarim.report_kargo_ciktisi_document"/>
                </t>
                <t t-else="">
                    <div class="page">
                        <h3>Kargo transferi bulunamadı</h3>
                        <p>Arıza kaydı <strong t-esc="ariza.name"/> için basılacak kargo transferi yok.</p>
                        <p>Gidiş kargosu ONAYLA adımında (kargo metodu seçiliyse), iade kargosu
                           teslim adımında "Adrese Gönderilsin" seçildiğinde otomatik oluşur;
                           Aras barkodu transfer doğrulanınca gelir.</p>
                    </div>
                </t>
                <p t-if="not ariza_last" style="page-break-after: always;"/>
            </t>
        </t>
    </template>

    <!-- Rapor aksiyonları.
         Yazdır menüsüne BAĞLI DEĞİLLER (binding yok, 2026-08-14): Aras barkod
         şeridi Arıza Kayıt Raporu'na gömülü olduğundan (tek belge) ayrı Kargo
         Çıktısı seçeneğine gerek kalmadı. Kayıtlar programatik kullanım için
         (action_print_kargo_ciktisi) duruyor. -->
    <record id="action_report_kargo_ciktisi" model="ir.actions.report">
        <field name="name">Kargo Çıktısı</field>
        <field name="model">ariza.kayit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ariza_onarim.report_kargo_ciktisi</field>
        <field name="report_file">ariza_onarim.report_kargo_ciktisi</field>
        <field name="paperformat_id" ref="paperformat_kargo_ciktisi_a5"/>
        <!-- Dosya adında '/' olamaz (kayıt adı ARZ/2026/xxxxx içerir) -->
        <field name="print_report_name">'Kargo Ciktisi - %s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="action_report_kargo_ciktisi_a4" model="ir.actions.report">
        <field name="name">Kargo Çıktısı - A4</field>
        <field name="model">ariza.kayit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ariza_onarim.report_kargo_ciktisi_a4</field>
        <field name="report_file">ariza_onarim.report_kargo_ciktisi_a4</field>
        <field name="paperformat_id" ref="paperformat_kargo_ciktisi_a4"/>
        <field name="print_report_name">'Kargo Ciktisi A4 - %s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
